<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.kuck.sidecar-edge-watch</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/Library/Application Support/Mac电脑管理/随航边沿守护.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/sidecar-edge-watch.err.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/sidecar-edge-watch.out.log</string>
</dict>
</plist>
